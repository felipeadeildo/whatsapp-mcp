{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsapp-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  // OAuth clients can point the Worker at a metadata URL. This keeps those fetches off private addresses.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // The pairing page and the MCP endpoint live on the workers.dev address;
  // per-version preview URLs would only add more ways in.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "secrets": { "required": ["SECRET"] },
  // OAuth clients and grants. Created on the first deploy.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Sign-in attempts per IP.
  "ratelimits": [
    { "name": "SIGN_IN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
  "vars": {
    // IANA zone the tools show and read times in.
    "TIMEZONE": "UTC",
    // "oauth", "api_key" (SECRET as a Bearer token) or "both".
    "AUTH_MODE": "both",
  },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT", "class_name": "WhatsAppAccount" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WhatsAppAccount"] }],
}
